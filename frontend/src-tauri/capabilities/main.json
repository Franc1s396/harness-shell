{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Runtime and SSH profile management access for the fixed main window.",
  "windows": ["main"],
  "permissions": [
    "runtime",
    "credentials",
    "agent",
    "connections",
    "terminal",
    "sftp",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
