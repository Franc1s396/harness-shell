{
  "$defs": {
    "ConnectionStatus": {
      "additionalProperties": false,
      "description": "对桌面端公开的 SSH 连接状态快照。",
      "properties": {
        "connection_id": {
          "format": "uuid",
          "title": "Connection Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "host_key_candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostKeyCandidate"
            },
            {
              "type": "null"
            }
          ]
        },
        "recoverable": {
          "title": "Recoverable",
          "type": "boolean"
        },
        "session_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Session Id"
        },
        "state": {
          "enum": [
            "DISCONNECTED",
            "CONNECTING",
            "HOST_KEY_REQUIRED",
            "READY",
            "CLOSING",
            "FAILED"
          ],
          "title": "State",
          "type": "string"
        },
        "trusted_fingerprint_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trusted Fingerprint Sha256"
        }
      },
      "required": [
        "connection_id",
        "state",
        "session_id",
        "error_code",
        "recoverable",
        "correlation_id",
        "host_key_candidate"
      ],
      "title": "ConnectionStatus",
      "type": "object"
    },
    "HostKeyCandidate": {
      "additionalProperties": false,
      "description": "等待用户确认或替换的远端 SSH Host Key 候选值。",
      "properties": {
        "connection_id": {
          "format": "uuid",
          "title": "Connection Id",
          "type": "string"
        },
        "fingerprint_sha256": {
          "pattern": "^SHA256:[A-Za-z0-9+/=_-]+$",
          "title": "Fingerprint Sha256",
          "type": "string"
        },
        "host": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "key_algorithm": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Key Algorithm",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "public_key_openssh_b64": {
          "title": "Public Key Openssh B64",
          "type": "string"
        }
      },
      "required": [
        "connection_id",
        "host",
        "port",
        "key_algorithm",
        "fingerprint_sha256",
        "public_key_openssh_b64"
      ],
      "title": "HostKeyCandidate",
      "type": "object"
    },
    "JsonValue": {},
    "MutationProgressProjection": {
      "additionalProperties": false,
      "description": "发布安全的手动变更阶段，不含本地路径或原始错误。",
      "properties": {
        "cancellable": {
          "const": false,
          "title": "Cancellable",
          "type": "boolean"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "host_label": {
          "title": "Host Label",
          "type": "string"
        },
        "items_completed": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items Completed"
        },
        "items_total": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items Total"
        },
        "kind": {
          "enum": [
            "mkdir",
            "rename",
            "remove",
            "recursive_delete",
            "recovery"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "phase": {
          "enum": [
            "preparing",
            "isolating",
            "deleting",
            "cleaning",
            "committing"
          ],
          "title": "Phase",
          "type": "string"
        },
        "remote_path": {
          "title": "Remote Path",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "kind",
        "phase",
        "display_name",
        "remote_path",
        "host_label",
        "items_completed",
        "items_total",
        "cancellable"
      ],
      "title": "MutationProgressProjection",
      "type": "object"
    },
    "PtyClosedMessage": {
      "additionalProperties": false,
      "description": "发布主动推送的 PTY 关闭事件。",
      "properties": {
        "causation_id": {
          "title": "Causation Id",
          "type": "null"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/PtyClosedPayload"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "const": "pty.closed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "causation_id",
        "timestamp",
        "type",
        "payload"
      ],
      "title": "PtyClosedMessage",
      "type": "object"
    },
    "PtyClosedPayload": {
      "additionalProperties": false,
      "description": "保留当前 PTY 进程退出投影。",
      "properties": {
        "exit_signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Signal"
        },
        "exit_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Status"
        },
        "pty_session_id": {
          "format": "uuid",
          "title": "Pty Session Id",
          "type": "string"
        }
      },
      "required": [
        "pty_session_id",
        "exit_status",
        "exit_signal"
      ],
      "title": "PtyClosedPayload",
      "type": "object"
    },
    "PtyInputMessage": {
      "additionalProperties": false,
      "description": "通过 Runtime WebSocket 请求带关联标识的 PTY 写入。",
      "properties": {
        "causation_id": {
          "title": "Causation Id",
          "type": "null"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/PtyInputPayload"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "const": "pty.input",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "causation_id",
        "timestamp",
        "type",
        "payload"
      ],
      "title": "PtyInputMessage",
      "type": "object"
    },
    "PtyInputPayload": {
      "additionalProperties": false,
      "description": "携带有界标准 Base64 PTY 输入分块。",
      "properties": {
        "data_b64": {
          "contentEncoding": "base64",
          "title": "Data B64",
          "type": "string"
        },
        "pty_session_id": {
          "format": "uuid",
          "title": "Pty Session Id",
          "type": "string"
        }
      },
      "required": [
        "pty_session_id",
        "data_b64"
      ],
      "title": "PtyInputPayload",
      "type": "object"
    },
    "PtyInputResultMessage": {
      "additionalProperties": false,
      "description": "关联 PTY 输入成功或稳定领域失败。",
      "properties": {
        "causation_id": {
          "format": "uuid",
          "title": "Causation Id",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/PtyInputResultPayload"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "const": "pty.input_result",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "causation_id",
        "timestamp",
        "type",
        "payload"
      ],
      "title": "PtyInputResultMessage",
      "type": "object"
    },
    "PtyInputResultPayload": {
      "additionalProperties": false,
      "description": "报告精确 PTY 写入结果，不因领域失败关闭连接。",
      "properties": {
        "accepted_bytes": {
          "maximum": 32768,
          "minimum": 0,
          "title": "Accepted Bytes",
          "type": "integer"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "pty_session_id": {
          "format": "uuid",
          "title": "Pty Session Id",
          "type": "string"
        }
      },
      "required": [
        "pty_session_id",
        "accepted_bytes",
        "error_code"
      ],
      "title": "PtyInputResultPayload",
      "type": "object"
    },
    "PtyOutputMessage": {
      "additionalProperties": false,
      "description": "发布主动推送的 PTY 输出事件。",
      "properties": {
        "causation_id": {
          "title": "Causation Id",
          "type": "null"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/PtyOutputPayload"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "const": "pty.output",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "causation_id",
        "timestamp",
        "type",
        "payload"
      ],
      "title": "PtyOutputMessage",
      "type": "object"
    },
    "PtyOutputPayload": {
      "additionalProperties": false,
      "description": "携带单调有序的 PTY 输出分块。",
      "properties": {
        "data_b64": {
          "contentEncoding": "base64",
          "title": "Data B64",
          "type": "string"
        },
        "pty_session_id": {
          "format": "uuid",
          "title": "Pty Session Id",
          "type": "string"
        },
        "stream_sequence": {
          "minimum": 0,
          "title": "Stream Sequence",
          "type": "integer"
        }
      },
      "required": [
        "pty_session_id",
        "data_b64",
        "stream_sequence"
      ],
      "title": "PtyOutputPayload",
      "type": "object"
    },
    "RuntimeErrorMessage": {
      "additionalProperties": false,
      "description": "关联非 PTY 领域失败，同时保留连接。",
      "properties": {
        "causation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Causation Id"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/RuntimeErrorPayload"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "const": "runtime.error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "causation_id",
        "timestamp",
        "type",
        "payload"
      ],
      "title": "RuntimeErrorMessage",
      "type": "object"
    },
    "RuntimeErrorPayload": {
      "additionalProperties": false,
      "description": "暴露稳定 WebSocket 领域失败，不包含原始内部信息。",
      "properties": {
        "details": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Details"
        },
        "error_code": {
          "title": "Error Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "error_code",
        "message",
        "details"
      ],
      "title": "RuntimeErrorPayload",
      "type": "object"
    },
    "RuntimePingMessage": {
      "additionalProperties": false,
      "description": "仅刷新显式 Runtime 心跳状态。",
      "properties": {
        "causation_id": {
          "title": "Causation Id",
          "type": "null"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/RuntimePingPayload"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "const": "runtime.ping",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "causation_id",
        "timestamp",
        "type",
        "payload"
      ],
      "title": "RuntimePingMessage",
      "type": "object"
    },
    "RuntimePingPayload": {
      "additionalProperties": false,
      "description": "携带桌面端显式心跳时间戳。",
      "properties": {
        "client_timestamp": {
          "format": "date-time",
          "title": "Client Timestamp",
          "type": "string"
        }
      },
      "required": [
        "client_timestamp"
      ],
      "title": "RuntimePingPayload",
      "type": "object"
    },
    "RuntimePongMessage": {
      "additionalProperties": false,
      "description": "关联显式 Runtime ping。",
      "properties": {
        "causation_id": {
          "format": "uuid",
          "title": "Causation Id",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/RuntimePongPayload"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "const": "runtime.pong",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "causation_id",
        "timestamp",
        "type",
        "payload"
      ],
      "title": "RuntimePongMessage",
      "type": "object"
    },
    "RuntimePongPayload": {
      "additionalProperties": false,
      "description": "携带服务器带时区的心跳响应时间。",
      "properties": {
        "server_timestamp": {
          "format": "date-time",
          "title": "Server Timestamp",
          "type": "string"
        }
      },
      "required": [
        "server_timestamp"
      ],
      "title": "RuntimePongPayload",
      "type": "object"
    },
    "SftpOperationProgressMessage": {
      "additionalProperties": false,
      "description": "发布完整的当前安全手动 SFTP 进展投影。",
      "properties": {
        "causation_id": {
          "title": "Causation Id",
          "type": "null"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/MutationProgressProjection"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "const": "sftp.operation_progress",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "causation_id",
        "timestamp",
        "type",
        "payload"
      ],
      "title": "SftpOperationProgressMessage",
      "type": "object"
    },
    "SshConnectionStateMessage": {
      "additionalProperties": false,
      "description": "发布完整的当前安全 SSH 状态投影。",
      "properties": {
        "causation_id": {
          "title": "Causation Id",
          "type": "null"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ConnectionStatus"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "const": "ssh.connection_state",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "causation_id",
        "timestamp",
        "type",
        "payload"
      ],
      "title": "SshConnectionStateMessage",
      "type": "object"
    },
    "message_type": {
      "enum": [
        "pty.input",
        "pty.input_result",
        "pty.output",
        "pty.closed",
        "ssh.connection_state",
        "sftp.operation_progress",
        "runtime.ping",
        "runtime.pong",
        "runtime.error"
      ],
      "type": "string"
    }
  },
  "$id": "https://harness-shell.local/schemas/runtime-websocket-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Strict server and client messages carried by /v1/runtime/events after HTTP runtime initialization.",
  "discriminator": {
    "mapping": {
      "pty.closed": "#/$defs/PtyClosedMessage",
      "pty.input": "#/$defs/PtyInputMessage",
      "pty.input_result": "#/$defs/PtyInputResultMessage",
      "pty.output": "#/$defs/PtyOutputMessage",
      "runtime.error": "#/$defs/RuntimeErrorMessage",
      "runtime.ping": "#/$defs/RuntimePingMessage",
      "runtime.pong": "#/$defs/RuntimePongMessage",
      "sftp.operation_progress": "#/$defs/SftpOperationProgressMessage",
      "ssh.connection_state": "#/$defs/SshConnectionStateMessage"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PtyInputMessage"
    },
    {
      "$ref": "#/$defs/PtyInputResultMessage"
    },
    {
      "$ref": "#/$defs/PtyOutputMessage"
    },
    {
      "$ref": "#/$defs/PtyClosedMessage"
    },
    {
      "$ref": "#/$defs/SshConnectionStateMessage"
    },
    {
      "$ref": "#/$defs/SftpOperationProgressMessage"
    },
    {
      "$ref": "#/$defs/RuntimePingMessage"
    },
    {
      "$ref": "#/$defs/RuntimePongMessage"
    },
    {
      "$ref": "#/$defs/RuntimeErrorMessage"
    }
  ],
  "title": "Harness Shell Runtime WebSocket v1",
  "x-max-text-message-bytes": 65536,
  "x-queue-capacity": 64
}
