          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e35" value="是：记录并通知" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#64748b;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="valid" target="resolved">
          <mxGeometry as="geometry" relative="1" />
