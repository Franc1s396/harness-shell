        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="2" name="02 · 审核暂停与恢复">
    <mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="2060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Human in the Loop · 审核决定如何恢复原 Run" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;text;align=left;fontStyle=1;fontSize=26;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="20" width="1490" height="55" />
        </mxCell>
        <mxCell id="ui" value="React UI / HTTP 接口" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;swimlane;startSize=44;fillColor=#f5f5f5;swimlaneFillColor=#fafafa;strokeColor=#cccccc;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="100" width="470" height="1730" />
        </mxCell>
        <mxCell id="svc" value="AgentService / 原 SSE worker" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;swimlane;startSize=44;fillColor=#f5f5f5;swimlaneFillColor=#fafafa;strokeColor=#cccccc;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="100" width="470" height="1730" />
        </mxCell>
        <mxCell id="lg" value="LangGraph / SSH 执行" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;swimlane;startSize=44;fillColor=#f5f5f5;swimlaneFillColor=#fafafa;strokeColor=#cccccc;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1060" y="100" width="470" height="1730" />
        </mxCell>
        <mxCell id="freeze" value="prepare_tool&lt;br&gt;冻结 approval_id、Run / Session / tool_call&lt;br&gt;原始命令及目标快照" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1130" y="185" width="330" height="110" />
        </mxCell>
        <mxCell id="interrupt" value="await_approval&lt;br&gt;interrupt(request) 暂停 Graph&lt;br&gt;此节点不发布事件、不写库、不执行 SSH" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1130" y="345" width="330" height="110" />
        </mxCell>
        <mxCell id="register" value="读取 __interrupt__ 并校验身份&lt;br&gt;ApprovalRegistry.register(request)" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="345" width="330" height="110" />
        </mxCell>
        <mxCell id="publish" value="原 SSE 发布&lt;br&gt;agent.turn.approval_requested" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="505" width="330" height="85" />
        </mxCell>
        <mxCell id="bubble" value="reducer → AgentApprovalBubble&lt;br&gt;显示冻结目标和原始命令&lt;br&gt;底部按钮：拒绝 / 通过" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="505" width="330" height="110" />
        </mxCell>
        <mxCell id="click" value="useAgentController.decideApproval&lt;br&gt;agentApi.decideAgentApproval" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="680" width="330" height="110" />
        </mxCell>
        <mxCell id="wait" value="_wait_for_approval&lt;br&gt;等待决定 / 取消 / SSH 不可用&lt;br&gt;&lt;b&gt;无限等待，无审核计时器&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="680" width="330" height="110" />
        </mxCell>
        <mxCell id="http" value="POST /v1/agent/approvals/&lt;br&gt;{approval_id}/decision&lt;br&gt;只提交身份字段与 approve / reject" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="845" width="330" height="110" />
        </mxCell>
        <mxCell id="decide" value="独立 approval 控制槽位&lt;br&gt;handler → Service.decide_approval&lt;br&gt;→ ApprovalRegistry.decide" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="845" width="330" height="110" />
        </mxCell>
        <mxCell id="valid" value="身份、状态及原 Session&lt;br&gt;是否合法？" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="1010" width="220" height="100" />
        </mxCell>
        <mxCell id="problem" value="返回 Problem Details&lt;br&gt;404 不存在 / 409 冲突或失效&lt;br&gt;422 请求校验失败" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="1010" width="330" height="100" />
        </mxCell>
        <mxCell id="ack" value="HTTP 200：APPROVED / REJECTED&lt;br&gt;&lt;b&gt;只表示决定已记录&lt;/b&gt;&lt;br&gt;不代表命令已执行" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="1180" width="330" height="110" />
        </mxCell>
        <mxCell id="resolved" value="唤醒原 SSE worker&lt;br&gt;复核取消状态及原 SSH 可用性&lt;br&gt;发布 agent.turn.approval_resolved" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="1180" width="330" height="110" />
        </mxCell>
        <mxCell id="resume" value="graph.ainvoke(Command(resume=...))&lt;br&gt;同一 thread_id / Run / context&lt;br&gt;不创建新 worker 或新 Run" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="1350" width="330" height="110" />
        </mxCell>
        <mxCell id="return" value="await_approval 重新进入&lt;br&gt;interrupt 返回决定&lt;br&gt;严格校验 approval_id 和 decision" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1130" y="1350" width="330" height="110" />
        </mxCell>
        <mxCell id="choice" value="审核决定" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1185" y="1505" width="220" height="95" />
        </mxCell>
        <mxCell id="approve" value="通过：校验冻结操作并 consume&lt;br&gt;发布 tool_started → SSH 执行&lt;br&gt;结果回到 record_tool_result / 模型" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1130" y="1660" width="330" height="110" />
        </mxCell>
        <mxCell id="reject" value="拒绝：COMMAND_REJECTED_BY_USER&lt;br&gt;不触发 tool_started 或 SSH&lt;br&gt;结果回到 record_tool_result / 模型" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="1660" width="330" height="110" />
        </mxCell>
        <mxCell id="stop" value="取消 / SSE 断开 / 原 SSH 不可用&lt;br&gt;退出等待，禁止尚未执行的操作&lt;br&gt;finally 释放审核记录与内存 checkpoint&lt;br&gt;不撤销已经发出的远端命令" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="1480" width="330" height="140" />
        </mxCell>
