            <Array as="points">
              <mxPoint x="30" y="795" />
              <mxPoint x="30" y="1420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e45" value="取消 / 断连" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#64748b;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="approval" target="cleanup">
          <mxGeometry as="geometry" relative="1">
