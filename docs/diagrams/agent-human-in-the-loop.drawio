        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#64748b;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="resolved" target="resume">
