        <mxCell id="e31" value="校验失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#64748b;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="prepare" target="bad">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e32" value="AUTO_READ_ONLY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#64748b;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="policy" target="execute">
          <mxGeometry as="geometry" relative="1" />
