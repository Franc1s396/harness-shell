        <mxCell id="e39" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#64748b;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="choice" target="approve">
          <mxGeometry as="geometry" relative="1" />
