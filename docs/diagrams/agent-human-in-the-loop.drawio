<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Codex" version="26.0.0" type="device">
  <diagram id="1" name="01 · Agent 主流程">
    <mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Human in the Loop · Agent 代码主流程" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;text;align=left;fontStyle=1;fontSize=26;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="25" width="1320" height="55" />
        </mxCell>
        <mxCell id="intro" value="明确只读自动执行，其余逐次审核；原危险规则仍然硬阻断。黄色审核节点展开见第 02 页。" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;shape=note;fillColor=#fffbe6;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="85" width="1320" height="65" />
        </mxCell>
        <mxCell id="send" value="UI：requestSend → dispatchTurn&lt;br&gt;agentApi.streamAgentTurn&lt;br&gt;POST /v1/agent/turns（SSE）" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="180" width="330" height="95" />
        </mxCell>
        <mxCell id="run" value="AgentService：冻结 Provider / SSH Session&lt;br&gt;创建 Run，发送 started" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="315" width="330" height="90" />
        </mxCell>
        <mxCell id="graph" value="_invoke_until_terminal&lt;br&gt;每 Run 独立 Graph + InMemorySaver&lt;br&gt;load_context → prepare_model_context" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="455" width="330" height="105" />
        </mxCell>
        <mxCell id="model" value="call_model&lt;br&gt;模型生成文本或 execute_command 调用" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="610" width="330" height="85" />
        </mxCell>
        <mxCell id="has" value="有工具调用？" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="595" y="745" width="220" height="100" />
        </mxCell>
        <mxCell id="final" value="return_response&lt;br&gt;返回最终文本，Graph 结束" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;arcSize=40;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="750" width="330" height="90" />
        </mxCell>
        <mxCell id="limit" value="超过 ReAct 迭代上限？" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="595" y="895" width="220" height="110" />
        </mxCell>
        <mxCell id="limitend" value="reject_limit&lt;br&gt;配对工具错误，LIMIT_REACHED" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="905" width="330" height="95" />
        </mxCell>
        <mxCell id="prepare" value="prepare_tool&lt;br&gt;校验单次调用、工具名称和参数" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="1060" width="330" height="90" />
        </mxCell>
        <mxCell id="bad" value="拒绝无效调用或危险命令&lt;br&gt;多工具 / 未知工具 / 参数非法&lt;br&gt;或 BLOCKED：配对工具错误" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1030" y="1060" width="340" height="110" />
        </mxCell>
        <mxCell id="policy" value="classify_command" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="575" y="1200" width="260" height="105" />
        </mxCell>
        <mxCell id="approval" value="冻结 ApprovalRequest&lt;br&gt;await_approval → interrupt&lt;br&gt;Service 发布审核气泡并等待决定" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1030" y="1230" width="340" height="110" />
        </mxCell>
        <mxCell id="execute" value="execute_tool&lt;br&gt;复核取消状态及原始操作&lt;br&gt;审核操作还须 consume 一次性授权" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="1400" width="330" height="105" />
        </mxCell>
        <mxCell id="reject" value="COMMAND_REJECTED_BY_USER&lt;br&gt;不执行命令，构造配对 ToolMessage" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1030" y="1410" width="340" height="90" />
        </mxCell>
        <mxCell id="ssh" value="发布 tool_started&lt;br&gt;SshCommandExecutor.execute&lt;br&gt;复核连接 → create_process → 工具结果" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="1550" width="330" height="105" />
        </mxCell>
        <mxCell id="record" value="record_tool_result&lt;br&gt;短事务记录结果，清除临时审核状态&lt;br&gt;prepare_model_context" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1030" y="1550" width="340" height="105" />
        </mxCell>
        <mxCell id="cleanup" value="_invoke_until_terminal finally&lt;br&gt;释放 ApprovalRegistry / 等待任务&lt;br&gt;删除该 Run 的内存 checkpoint" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;arcSize=40;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1370" width="350" height="110" />
        </mxCell>
        <mxCell id="end" value="Service 收敛终态并发送&lt;br&gt;completed / failed&lt;br&gt;连接断开时无法保证终态事件送达" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;spacing=8;rounded=1;arcSize=40;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1550" width="350" height="105" />
        </mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#64748b;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="send" target="run">
